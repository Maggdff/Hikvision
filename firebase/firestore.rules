rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // الملف العام: يقرؤه أي مستخدم مسجل، وينشئه صاحبه مرة واحدة فقط.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'bio', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.createdAt == request.time;
      // تعديل الملف: للمالك فقط وللحقول الثلاثة فقط (username وcreatedAt ثابتان).
      // قائمة الدول يجب أن تطابق backend/src/rooms/countries.ts.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'country'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && (!('country' in request.resource.data)
            || request.resource.data.country in ['AE','BH','DJ','DZ','EG','IQ','JO','KM','KW','LB','LY','MA','MR','OM','PS','QA','SA','SD','SY','SO','TN','YE']);
      allow delete: if false;

      // تاريخ الميلاد: للمالك فقط، يُنشأ مرة واحدة ولا يُعدَّل.
      match /private/{doc} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && doc == 'profile'
          && request.resource.data.keys().hasOnly(['birthDate'])
          && request.resource.data.birthDate is string
          && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow update, delete: if false;
      }
    }

    // حجز اسم المستخدم: ينشئه صاحبه فقط، ولا يتغير.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // كل ما عدا ذلك مغلق افتراضياً.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
